generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

model User {
  id                   String      @id @default(uuid())
  name                 String
  email                String      @unique
  emailVerified        Boolean     @default(false)
  image                String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  role                 UserRole    @default(CLIENT)
  phoneNumber          String?
  contractEndDate      DateTime?
  createdById          String?
  passwordVerified     Boolean     @default(false)
  deletedAt            DateTime?
  companyId            String?
  accounts             Account[]
  auditLogs            AuditLog[]  @relation("UserAuditLogs")
  submittedBookings    Booking[]   @relation("SubmittedBookings")
  updatedBookings      Booking[]   @relation("UpdatedBookings")
  createdBuildings     Building[]
  representedCompanies Company[]   @relation("CompanyRepresentative")
  rejectedBookings     Rejection[]
  createdRooms         Room[]
  sessions             Session[]
  company              Company?    @relation(fields: [companyId], references: [id])
  createdBy            User?       @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers         User[]      @relation("UserCreator")

  @@index([companyId])
  @@map("users")
}

model Company {
  id                  String    @id @default(uuid())
  name                String    @unique
  allottedCreditHours Float     @default(0)
  usedCreditHours     Float     @default(0)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  representativeId    String?
  bookings            Booking[]
  representative      User?     @relation("CompanyRepresentative", fields: [representativeId], references: [id])
  users               User[]

  @@index([representativeId])
  @@map("companies")
}

model WalkInCustomer {
  id          String    @id @default(uuid())
  name        String
  companyName String?
  email       String    @unique
  phoneNumber String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]

  @@map("walk_in_customers")
}

model Session {
  id        String    @id @default(uuid())
  expiresAt DateTime
  token     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
  deletedAt  DateTime?

  @@map("verifications")
}

model Building {
  id           String         @id @default(uuid())
  buildingName String
  buildingCode String         @unique
  description  String?
  imageUrl     String?
  status       BuildingStatus
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  address      String?
  deletedAt    DateTime?
  bookings     Booking[]
  createdBy    User           @relation(fields: [createdById], references: [id])
  rooms        Room[]

  @@map("buildings")
}

model Room {
  id          String     @id @default(uuid())
  roomName    String
  roomCode    String?
  description String?
  imageUrl    String?
  capacity    Int
  amenities   Json?
  status      RoomStatus
  buildingId  String
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  bookings    Booking[]
  building    Building   @relation(fields: [buildingId], references: [id])
  createdBy   User       @relation(fields: [createdById], references: [id])

  @@index([buildingId])
  @@map("rooms")
}

model Booking {
  id                   String          @id @default(uuid())
  bookingReference     String          @unique
  startDate            DateTime
  endDate              DateTime
  dailyTimeStart       DateTime?
  dailyTimeEnd         DateTime?
  bookingType          BookingType
  clientStatus         ClientStatus
  approvalStatus       ApprovalStatus
  submittedAt          DateTime        @default(now())
  approvalDate         DateTime?
  cancellationDeadline DateTime?
  message              String?
  attendeeCount        Int?
  buildingId           String
  roomId               String
  submittedById        String
  updatedById          String?
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?
  companyId            String?
  creditHoursUsed      Float           @default(0)
  walkInCustomerId     String?
  building             Building        @relation(fields: [buildingId], references: [id])
  company              Company?        @relation(fields: [companyId], references: [id])
  room                 Room            @relation(fields: [roomId], references: [id])
  submittedBy          User            @relation("SubmittedBookings", fields: [submittedById], references: [id])
  updatedBy            User?           @relation("UpdatedBookings", fields: [updatedById], references: [id])
  walkInCustomer       WalkInCustomer? @relation(fields: [walkInCustomerId], references: [id])
  rejections           Rejection[]

  @@index([roomId, startDate, endDate])
  @@index([buildingId])
  @@index([companyId])
  @@index([walkInCustomerId])
  @@index([approvalStatus])
  @@map("bookings")
}

model Rejection {
  id              String        @id @default(uuid())
  rejectionType   RejectionType
  rejectionReason String
  rejectedAt      DateTime      @default(now())
  bookingId       String
  rejectedById    String
  deletedAt       DateTime?
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rejectedBy      User          @relation(fields: [rejectedById], references: [id])

  @@index([bookingId])
  @@map("rejections")
}

model AuditLog {
  id          String      @id @default(uuid())
  logNumber   String      @unique
  action      AuditAction
  status      AuditStatus
  module      String
  entityType  String
  entityId    String?
  targetLabel String?
  actorId     String
  changes     Json?
  summary     String?
  ipAddress   String?
  userAgent   String?
  requestId   String?
  occurredAt  DateTime    @default(now())
  actor       User        @relation("UserAuditLogs", fields: [actorId], references: [id])

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([module, occurredAt])
  @@index([entityType, entityId, occurredAt])
  @@index([action, status, occurredAt])
  @@map("audit_logs")
}

enum UserRole {
  CLIENT
  ADMIN
  SUPERADMIN
  STAFF
}

enum BuildingStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum BookingType {
  HOURLY
  DAILY
  MONTHLY
}

enum ClientStatus {
  SUBMITTED
  CANCELLED
}

enum ApprovalStatus {
  RESCHEDULED
  CONFIRMED
}

enum RejectionType {
  CAPACITY_EXCEEDED
  SCHEDULE_CONFLICT
  MAINTENANCE
  POLICY_VIOLATION
  INVALID_REQUEST
  CONTRACT_EXPIRED
  OTHER
}

enum AuditAction {
  CREATE
  EDIT
  DELETE
}

enum AuditStatus {
  SUCCESS
  FAILED
}
